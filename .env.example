# FastAPI title (used in docs/OpenAPI)
APP_TITLE=Random Star Trek Picker

# Base path prefix when running behind reverse proxy, e.g. /random-star-trek
# Leave empty to serve at /
APP_BASE_PATH=

# Amazon domain used for generated Prime Video search links
PRIME_VIDEO_DOMAIN=www.amazon.de

# Upstream HTTP timeout in seconds
REQUEST_TIMEOUT_SECONDS=20

# In-memory catalog cache TTL in seconds
CACHE_TTL_SECONDS=3600

# User-Agent sent to TVMaze/Wikipedia requests
USER_AGENT=random-star-trek-app/1.0

# Enable server-side persistence of selected filters to data/filters_state.json
# Accepted values: true / false
PERSIST_FILTERS=false
